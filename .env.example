# Local server
PORT=4317
APP_BASE_URL=http://localhost:4317
SQLITE_FILE=.data/local.json
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-local-secret

# Local demo defaults
PROVIDER_MODE=mock
TRANSFER_PROVIDER=mock
X_AUTH_MODE=mock
AUTOMATION_WORKER_ENABLED=1
AGENT_MODEL_ENABLED=0

# Arc Testnet
# Optional: set to a tracked Canteen RPC URL for launch readiness.
ARC_TESTNET_RPC_URL=
ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.network
DEFAULT_SETTLEMENT_RAIL=arc-testnet
SUPPORTED_SETTLEMENT_RAILS=arc-testnet,base-sepolia

# X / Twitter integration
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4317/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access
X_WEBHOOK_SECRET=
X_REPLY_ENABLED=0
X_BOT_ACCESS_TOKEN=

# Circle wallets and transfers
CIRCLE_WALLETS_ENABLED=0
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_SECRET_CIPHERTEXT=
CIRCLE_WALLET_SET_ID=
CIRCLE_USDC_TOKEN_ID=
CIRCLE_WEBHOOK_PUBLIC_KEY_BASE64=
CIRCLE_WEBHOOK_SECRET=
CIRCLE_API_BASE_URL=https://api.circle.com

# DeFi adapters
DEFI_LIVE_ADAPTERS=0
DEFI_EXECUTION_ENABLED=0
DEFI_MAX_ACTION_USD=25
DEFI_MAX_SLIPPAGE=0.01
DEFI_ALLOWED_PROTOCOLS=lifi,circle-app-kit,polymarket
LIFI_API_KEY=

# AppKit
APPKIT_EXECUTION_ENABLED=0
APPKIT_UNIFIED_BALANCE_ENABLED=0
APPKIT_KIT_KEY=

# AI planner
AGENT_MODEL_PROVIDER=gemini
AGENT_MODEL=
GEMINI_API_KEY=
XAI_API_KEY=
